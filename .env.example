# ==============================================================================
# Crosscheck — Environment Configuration Template
# Copy this file to .env and configure your keys before running.
# ==============================================================================

# --- Primary LLM: Groq (Recommended: fast, high throughput, free tier) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Secondary / Fallback LLM: Google Gemini ---
# Optional fallback if using Gemini: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Local Embedding Model (Runs on CPU, zero API keys needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Ingestion & Chunking Configuration ---
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
EXTRACTION_BATCH_SIZE=6

# --- Canonicalization Thresholds ---
CANON_AUTO_THRESHOLD=0.97
CANON_TIEBREAK_THRESHOLD=0.60

# --- Evidence Grounding & Reasoning Limits ---
EVIDENCE_VERIFICATION_THRESHOLD=85
RELATIONSHIP_REASONING_MAX_PAIRS=15

# --- Storage & Audit Log Paths ---
DB_PATH=data/factstore.db
TRACE_LOG_PATH=data/traces.jsonl

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend Server (Next.js React) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
