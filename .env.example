# Environment variables
GOOGLE_API_KEY=your_google_api_key_here

# LLM model to use
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking config
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Fact extraction batching: chunks per LLM call (higher = faster, fewer API calls)
# Default 6 keeps prompt size manageable while cutting round-trips ~6x
EXTRACTION_BATCH_SIZE=6

# Canonicalization thresholds
CANON_AUTO_THRESHOLD=0.92
CANON_TIEBREAK_THRESHOLD=0.75

# Evidence verification threshold (rapidfuzz partial_ratio)
EVIDENCE_VERIFICATION_THRESHOLD=85

# Database path
DB_PATH=data/factstore.db
TRACE_LOG_PATH=data/traces.jsonl

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Streamlit
FRONTEND_PORT=8501
